{
  "name": "smartmarket-parser",
  "version": "2.0.0",
  "description": "SmartMarket Multi-Format Parser System",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "parse": "node src/index.js",
    "parse:products": "node src/index.js --type=products",
    "parse:promotions": "node src/index.js --type=promotions",
    "parse:stores": "node src/index.js --type=stores",

    "download:all": "node src/downloaders/gov-downloader.js",
    "sync:all": "npm run download:all && npm start",

    "dev": "nodemon src/index.js",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "winston": "^3.11.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  }
}